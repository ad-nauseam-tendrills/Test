# nginx vhost for running this app behind an existing nginx.
#
# Install:
#   sudo cp deploy/nginx-site.conf.example /etc/nginx/sites-available/blinksta
#   sudo sed -i 's/SITE_HOSTNAME/blinksta.edgarbustos.art/g' \
#       /etc/nginx/sites-available/blinksta
#   sudo ln -s /etc/nginx/sites-available/blinksta /etc/nginx/sites-enabled/blinksta
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then add TLS -- certbot rewrites this file, adding the 443 server block
# and an http -> https redirect:
#   sudo certbot --nginx -d blinksta.edgarbustos.art
#
# This block claims a single server_name, so other sites on the same
# nginx are unaffected.

server {
    # IPv4 only. An IPv6 listener is deliberately omitted: on a host
    # where IPv6 is disabled it fails `nginx -t`, which would block the
    # reload for every other site on this server too. Add
    # `listen [::]:80;` if you know the host has IPv6.
    listen 80;
    server_name SITE_HOSTNAME;

    # Uploads are capped at 20MB by the application. nginx defaults to
    # 1MB and rejects anything larger with a 413 before the request ever
    # reaches the app, so this must be raised or image uploads fail.
    client_max_body_size 30M;

    # Image analysis and optimization run synchronously and are CPU-bound;
    # on a small droplet a large upload can take a while. The 60s default
    # would cut those requests off mid-flight.
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;

    # Proxy headers are set at server level so every location inherits
    # them. Host must be forwarded so the app builds correct absolute
    # URLs, and X-Forwarded-Proto so it knows the original request was
    # HTTPS even though this hop is plain HTTP over loopback.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- Backend: API, health check, and docs ---
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000;
    }

    location /docs {
        proxy_pass http://127.0.0.1:8000;
    }

    location = /openapi.json {
        proxy_pass http://127.0.0.1:8000;
    }

    # --- Everything else: the Next.js frontend ---
    location / {
        proxy_pass http://127.0.0.1:3000;

        # Next.js uses websocket-style connections for some responses.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
