# Copy this file to .env and fill in values as needed.
# .env is git-ignored -- never commit real secrets.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Matches the "db" service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/instaopt

# --- URLs ---
CORS_ORIGINS=["http://localhost:3000"]
# Where the OAuth callback sends the browser after connecting an account.
FRONTEND_URL=http://localhost:3000

# --- Instagram / Meta integration ---
# The app connects real Instagram accounts through the OAuth flow below;
# accounts connected that way always use the real API regardless of this
# setting. It only supplies the default for a direct POST /accounts/connect.
INSTAGRAM_PROVIDER=mock

# The mock provider fabricates 60 synthetic posts. That is useful for
# local development and actively harmful on a real deployment, where it
# fills the dashboard with posts you never made and skews every
# recommendation. Leave this off outside development.
ENABLE_MOCK_PROVIDER=false

# --- Real Meta credentials (needed for "Connect Instagram") ---
#
# These are the INSTAGRAM App ID and Secret, found in your Meta app under
#   Instagram product -> "API setup with Instagram login"
# They are NOT the Facebook App ID/Secret shown on the main app settings
# page. Using the Facebook ones produces a confusing "Invalid platform
# app" error, so check this first if authentication fails.
#
# Setup:
#   1. developers.facebook.com -> My Apps -> Create App -> Other -> Business
#   2. Add products -> Instagram -> API setup with Instagram login
#   3. Permissions and features -> ADD instagram_business_manage_insights.
#      The "Add all required permissions" button does NOT include it (it
#      adds only basic/comments/messages). Without it, OAuth still
#      succeeds and posts still import, but every metric comes back empty
#      -- which looks like an app bug rather than a missing permission.
#   4. Add your Instagram professional account under the token step
#      (assign it the Instagram Tester role in the Roles tab first)
#   5. Register the redirect URI below in the Instagram business login settings
#
# Webhooks are not used by this app -- leave that section blank.
#
# While the app is in development mode, the Instagram accounts you add to
# it work immediately -- no App Review or Business Verification needed.
# Review is only required to serve accounts you do not control.
META_APP_ID=
META_APP_SECRET=

# Must be HTTPS -- Instagram rejects plain http://localhost. For local
# development, expose the backend through a tunnel and use that URL:
#   cloudflared tunnel --url http://localhost:8000
# then set e.g. https://your-tunnel.trycloudflare.com/api/v1/accounts/meta/callback
# This exact value must also be registered in the Meta app settings.
META_REDIRECT_URI=

META_GRAPH_API_VERSION=v23.0

# --- Single-user mode (optional) ---
# Removes the login screen by running every request as one owner account.
# For a personal deployment where signing in each time is friction.
#
# This is NOT access control -- it makes every visitor the owner. Only
# enable it on a deployment restricted at the network layer (firewall,
# IP allowlist, HTTP basic auth on the proxy, or a VPN).
#
# Leave SINGLE_USER_EMAIL blank to adopt the oldest existing account,
# which keeps a connected Instagram account and imported history intact
# when switching an already-running deployment over.
SINGLE_USER_MODE=false
SINGLE_USER_EMAIL=

# --- Caption suggestions (optional) ---
# Claude API key, used only by the caption-suggestion feature on the post
# page. Leave blank to disable it -- the rest of the app is unaffected and
# the endpoint returns a clear "not configured" message.
# Get one at https://console.anthropic.com. NEVER commit a real key.
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-opus-5

# --- File storage ---
UPLOAD_DIR=/app/storage/uploads
VARIANT_DIR=/app/storage/variants
MAX_UPLOAD_SIZE_MB=20
