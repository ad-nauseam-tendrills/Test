# Copy this file to .env and fill in values as needed.
# .env is git-ignored -- never commit real secrets.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Matches the "db" service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/instaopt

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Instagram / Meta integration ---
# "mock" (default) requires no credentials and generates realistic demo
# data. Set to "meta" only once you have real Meta app credentials and
# have implemented the Graph API calls in
# app/services/instagram/meta_provider.py.
INSTAGRAM_PROVIDER=mock

# Real Meta credentials -- only needed when INSTAGRAM_PROVIDER=meta.
# Create an app at https://developers.facebook.com/apps and configure
# Instagram Graph API access. NEVER commit real values here.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v19.0

# --- File storage ---
UPLOAD_DIR=/app/storage/uploads
VARIANT_DIR=/app/storage/variants
MAX_UPLOAD_SIZE_MB=20
