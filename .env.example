# Used by docker-compose.yml for variable substitution (${VAR:-default}).
# Copy to .env in the repo root to override defaults for `docker compose up`.
# .env is git-ignored -- never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

INSTAGRAM_PROVIDER=mock

# Instagram App ID/Secret from your Meta app's Instagram product
# ("API setup with Instagram login") -- NOT the Facebook App ID/Secret.
# Only needed to connect a real Instagram account. See backend/.env.example
# for full setup instructions.
META_APP_ID=
META_APP_SECRET=
# Must be HTTPS; use a tunnel for local dev (cloudflared/ngrok).
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v23.0
